{
  "name": "tingqiang",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python scripts/serve.py 8000 --open",
    "desktop": "node scripts/build-desktop.mjs run",
    "desktop:build": "node scripts/build-desktop.mjs installer",
    "android": "node scripts/build-android.mjs run",
    "android:build": "node scripts/build-android.mjs apk",
    "dev": "python -m uvicorn server.app:app --host 127.0.0.1 --port 8000",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs && python -m compileall -q server",
    "prepare:assets": "node scripts/copy-ort.mjs && node scripts/build-separator.mjs && node scripts/build-pinyin.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "onnxruntime-web": "1.20.1",
    "pinyin-pro": "^3.29.5",
    "signalsmith-stretch": "1.3.2"
  }
}
