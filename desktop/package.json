{
  "name": "tingqiang-desktop",
  "productName": "听腔",
  "version": "0.8.0",
  "description": "京剧唱腔练习",
  "author": "听腔",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.tingqiang.app",
    "executableName": "tingqiang",
    "directories": {"output": "out", "buildResources": "build"},
    "files": ["main.mjs", "preload.cjs", "package.json"],
    "extraResources": [{"from": "web", "to": "web"}],
    "electronLanguages": ["zh-CN", "en-US"],
    "fileAssociations": [{"ext": "tqproj", "name": "TingQiang.Project", "description": "听腔练习包"}],
    "win": {"target": "nsis", "icon": "build/icon.ico"},
    "nsis": {
      "artifactName": "听腔-安装程序-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "听腔",
      "runAfterFinish": true,
      "installerLanguages": ["zh_CN"],
      "language": "2052",
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  }
}
